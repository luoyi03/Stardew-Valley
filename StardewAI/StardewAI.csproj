<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>StardewAI</AssemblyName>
    <RootNamespace>StardewAI</RootNamespace>
    <Version>1.0.0</Version>
    <EnableHarmony>false</EnableHarmony>
    <GamePath>F:\steam\steamapps\common\Stardew Valley</GamePath>
    <IgnoreModFilePaths>^\.;^bin;^obj</IgnoreModFilePaths>
    <NoWarn>NETSDK1138;CS1591;NU1701</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 常驻语音合成助手：跟着 mod 一起部署到 Mods\StardewAI\ -->
    <None Update="tts_worker.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
