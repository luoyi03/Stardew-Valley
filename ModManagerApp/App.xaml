<Application x:Class="SMM.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SMM">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:StatusBrushConverter x:Key="StatusBrush" />
            <local:LevelBrushConverter x:Key="LevelBrush" />
            <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
