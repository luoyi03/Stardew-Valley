<UserControl x:Class="SMM.MultiplayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Window}">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnExport" Content="导出我的清单" Style="{StaticResource BtnAccent}"
                    Click="BtnExport_Click"
                    ToolTip="生成一个清单文件，发给一起玩的好友" />
            <Button x:Name="BtnCopy" Content="复制清单文本" Style="{StaticResource Btn}" Margin="8,0,0,0"
                    Click="BtnCopy_Click"
                    ToolTip="复制成文本，可以直接粘贴到 QQ / 微信里发给好友" />
            <Button x:Name="BtnImport" Content="导入好友的清单比对" Style="{StaticResource Btn}" Margin="8,0,0,0"
                    Click="BtnImport_Click"
                    ToolTip="选好友发来的清单文件，自动比出缺哪些、哪个版本不一样" />
            <Button x:Name="BtnPaste" Content="从剪贴板比对" Style="{StaticResource Btn}" Margin="8,0,0,0"
                    Click="BtnPaste_Click"
                    ToolTip="好友直接发了一段清单文本给你，复制后点这里" />
            <Button x:Name="BtnPlay2" Content="打开游戏" Style="{StaticResource Btn}" Margin="8,0,0,0"
                    Click="BtnPlay2_Click" />
        </StackPanel>

        <!-- 联机环境自检 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="好友要填的地址"
                               Style="{StaticResource T.Section}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="重新检测"
                            Style="{StaticResource Btn}" Padding="10,3" Click="BtnRefresh_Click" />
                </DockPanel>

                <!-- 大字 IP：这是好友「一起玩 → 加入」时要填的那个 -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="TxtIpBig" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource B.Ok}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtIpPort" FontSize="14" Margin="12,0,0,4"
                               Foreground="{StaticResource B.TextDim}" VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock x:Name="TxtIpOther" Style="{StaticResource T.Dim}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnInvite" Content="复制邀请信息给好友" Style="{StaticResource BtnAccent}"
                            Click="BtnInvite_Click"
                            ToolTip="复制一段现成的话（含 IP、端口、怎么进），直接粘到 QQ / 微信发给好友" />
                    <Button x:Name="BtnCopyIp" Content="只复制 IP" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Click="BtnCopyIp_Click" />
                    <Button x:Name="BtnFirewall" Content="一键放行防火墙" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnFirewall_Click" Visibility="Collapsed"
                            ToolTip="以管理员身份给游戏加放行规则（会弹 UAC 让你确认）" />
                </StackPanel>

                <Border Height="1" Background="{StaticResource B.Border}" Margin="0,12,0,10" />

                <!-- 开房状态 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DotRoom" Text="●" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtRoom" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource B.Text}" />
                </StackPanel>
                <TextBlock x:Name="TxtRoomHint" Style="{StaticResource T.Dim}"
                           TextWrapping="Wrap" Margin="14,2,0,0" />

                <!-- 防火墙 -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="DotFirewall" Text="●" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtFirewall" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{StaticResource B.Text}" />
                </StackPanel>
                <TextBlock x:Name="TxtFirewallHint" Style="{StaticResource T.Dim}"
                           TextWrapping="Wrap" Margin="14,2,0,0" />

                <TextBlock x:Name="TxtEnv" Style="{StaticResource T.Dim}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- 比对摘要 -->
        <TextBlock x:Name="TxtDiff" Grid.Row="2" Style="{StaticResource T.Dim}" Margin="0,0,0,8"
                   TextWrapping="Wrap" Text="还没有导入好友的清单。" />

        <!-- 比对结果 -->
        <Grid Grid.Row="3">
            <Border Style="{StaticResource Card}" Padding="6">
                <ListView x:Name="List" ItemContainerStyle="{StaticResource ModListItem}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="状态" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KindText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="Mod" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Id}" FontSize="11"
                                                       Foreground="{StaticResource B.TextDim}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="我的版本" Width="90"
                                            DisplayMemberBinding="{Binding MyVersion}" />
                            <GridViewColumn Header="好友版本" Width="90"
                                            DisplayMemberBinding="{Binding TheirVersion}" />
                            <GridViewColumn Header="更新源" Width="130"
                                            DisplayMemberBinding="{Binding Source}" />

                            <GridViewColumn Header="说明" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource B.TextDim}" MaxWidth="320" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="操作" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="自动安装" Style="{StaticResource Btn}" Padding="10,4"
                                                    Click="BtnRowInstall_Click"
                                                    Visibility="{Binding CanAutoInstall, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="打开网页" Style="{StaticResource Btn}" Padding="10,4"
                                                    Click="BtnRowPage_Click"
                                                    Visibility="{Binding PageUrl, Converter={StaticResource EmptyToCollapsed}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <TextBlock x:Name="TxtEmpty" TextWrapping="Wrap" MaxWidth="700"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{StaticResource B.TextDim}"
                       Text="还没有比对结果。&#10;&#10;和好友一起玩之前：&#10;1. 点「导出我的清单」生成清单文件，用 QQ / 微信发给好友&#10;2. 好友也装这个工具、导入你的清单，按提示补齐缺的 Mod&#10;3. 反过来他导他的一份给你，你点「导入好友的清单比对」检查一遍&#10;&#10;Mod 版本不一致是联机进不去、进去后贴图错乱的最常见原因。" />
        </Grid>

        <!-- 联机步骤 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,11" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="你和好友怎么进同一个存档" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap"
                           Text="① 你（主机，插网线）：打开游戏 → 标题界面点「一起玩」→「主持」→ 选你的存档 → 进游戏。&#10;② 点上面的「复制邀请信息给好友」发给他 —— 你们在同一个路由器下（他走 WiFi 也一样），他直接填这个 IP 就能连。&#10;③ 好友（客机）：标题界面点「一起玩」→「加入」→ 地址填这个 IP → 选角色进房。" />
                <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource B.Warn}"
                           Text="前提：两边的游戏版本、SMAPI 版本、Mod 版本必须一致 —— 不一致会进不去，或进去后贴图错乱。先用「导出我的清单」发给好友比对一遍。" />
                <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="如果哪天你们不在同一个网络了（比如各自在家），直连 IP 就用不了，那时候要改用游戏里的「邀请码」进房。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
