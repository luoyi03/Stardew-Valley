<UserControl x:Class="SMM.BrowsePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Window}">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 检索栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="CmbSource" Grid.Column="0" Width="255" SelectedIndex="0"
                      SelectionChanged="CmbSource_SelectionChanged">
                <ComboBoxItem Content="Nexus 榜单 · 最新发布" Tag="latest_added" />
                <ComboBoxItem Content="Nexus 榜单 · 最近更新" Tag="latest_updated" />
                <ComboBoxItem Content="Nexus 榜单 · 当前热门" Tag="trending" />
                <ComboBoxItem Content="GitHub · 按关键词搜索" Tag="github" />
                <ComboBoxItem Content="Nexus · 去网页搜索（浏览器）" Tag="web" />
            </ComboBox>

            <TextBox x:Name="TxtKeyword" Grid.Column="1" Margin="8,0,0,0" MaxWidth="380"
                     HorizontalAlignment="Left" MinWidth="260"
                     Tag="关键词 / Mod 编号（Nexus 不填关键词就列榜单，填编号可精确查）" />
            <Button x:Name="BtnSearch" Grid.Column="2" Content="检索" Style="{StaticResource BtnAccent}"
                    Margin="8,0,0,0" Click="BtnSearch_Click" />
            <Button x:Name="BtnOpenNexus" Grid.Column="3" Content="在网页上搜索 Mod" Style="{StaticResource Btn}"
                    Margin="8,0,0,0" Click="BtnOpenNexus_Click" />
        </Grid>

        <!-- 链接 / 编号安装 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="按链接 / 编号安装：" VerticalAlignment="Center"
                           Foreground="{StaticResource B.TextDim}" FontSize="12" />
                <TextBox x:Name="TxtLink" Grid.Column="1" Margin="10,0,10,0"
                         Tag="Nexus 链接或编号 / GitHub 仓库链接 / zip 直链 / 本地 zip 路径"
                         ToolTip="支持：Nexus Mod 链接或编号、GitHub 仓库链接、任意 zip 直链、本地 zip 路径" />
                <Button x:Name="BtnLinkInstall" Grid.Column="2" Content="安装" Style="{StaticResource Btn}"
                        Click="BtnLinkInstall_Click" />
            </Grid>
        </Border>

        <!-- 说明 -->
        <Border Grid.Row="2" Background="#1A2B3138" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
            <TextBlock x:Name="TxtHint" Foreground="{StaticResource B.TextDim}" FontSize="12"
                       TextWrapping="Wrap"
                       Text="提示：Nexus 官方接口不支持按关键词搜索，只能按榜单浏览或按编号精确查。" />
        </Border>

        <!-- 结果 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
            <ListView x:Name="List" ItemContainerStyle="{StaticResource ModListItem}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称 / 作者" Width="330">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Author}" FontSize="11"
                                                   Foreground="{StaticResource B.TextDim}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="来源" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource B.TextDim}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="最新版本" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Version}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="安装状态" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InstallStateText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.TextDim}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="简介" Width="390">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource B.TextDim}"
                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="操作" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="安装" Style="{StaticResource Btn}" Padding="10,4"
                                                Click="BtnRowInstall_Click" />
                                        <Button Content="网页" Style="{StaticResource Btn}" Padding="10,4"
                                                Margin="6,0,0,0" Click="BtnRowPage_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
