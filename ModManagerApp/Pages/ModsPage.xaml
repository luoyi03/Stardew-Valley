<UserControl x:Class="SMM.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
             Background="{StaticResource B.Window}">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnCheck" Content="检查更新" Style="{StaticResource Btn}" Click="BtnCheck_Click" />
                <Button x:Name="BtnUpdateAll" Content="一键更新全部" Style="{StaticResource BtnAccent}"
                        Margin="8,0,0,0" Click="BtnUpdateAll_Click" />
                <Button x:Name="BtnToggle" Content="启用 / 禁用" Style="{StaticResource Btn}"
                        Margin="8,0,0,0" Click="BtnToggle_Click" />
                <Button x:Name="BtnDelete" Content="删除" Style="{StaticResource BtnDanger}"
                        Margin="8,0,0,0" Click="BtnDelete_Click" />
                <Button x:Name="BtnImport" Content="从 zip 安装…" Style="{StaticResource Btn}"
                        Margin="8,0,0,0" Click="BtnImport_Click" />
                <Button x:Name="BtnOpenMods" Content="打开 Mods 目录" Style="{StaticResource Btn}"
                        Margin="8,0,0,0" Click="BtnOpenMods_Click" />
            </StackPanel>
        </Grid>

        <!-- 搜索 / 筛选 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Grid.Column="0" MaxWidth="420" HorizontalAlignment="Left"
                     MinWidth="320" TextChanged="TxtSearch_TextChanged"
                     Tag="搜索 Mod 名称 / ID / 作者…" />
            <ComboBox x:Name="CmbFilter" Grid.Column="1" Width="150" Margin="8,0,0,0"
                      SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="全部 Mod" />
                <ComboBoxItem Content="可更新" />
                <ComboBoxItem Content="已是最新" />
                <ComboBoxItem Content="无法检查" />
                <ComboBoxItem Content="已禁用" />
                <ComboBoxItem Content="重复安装" />
            </ComboBox>
            <TextBlock x:Name="TxtSummary" Grid.Column="2" Style="{StaticResource T.Dim}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,6,6,6">
            <ListView x:Name="List" SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource ModListItem}"
                      GridViewColumnHeader.Click="List_HeaderClick"
                      SelectionChanged="List_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Mod 名称" Width="340">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Id}" FontSize="11"
                                                   Foreground="{StaticResource B.TextDim}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="版本" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="最新版" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LatestVersion}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Ok}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="来源" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.TextDim}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="状态" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <ProgressBar Value="{Binding Progress}" Height="3" Margin="0,3,0,0"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="说明" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DetailText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.TextDim}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 选中详情 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtSelTitle" Text="在上面选一个 Mod 查看详情" Style="{StaticResource T.Title}" />
                    <TextBlock x:Name="TxtSelMeta" Style="{StaticResource T.Dim}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtSelDesc" Style="{StaticResource T.Dim}" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxHeight="72" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSelUpdate" Content="更新到最新" Style="{StaticResource BtnAccent}"
                            Click="BtnSelUpdate_Click" />
                    <Button x:Name="BtnSelSource" Content="补写更新源" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnSelSource_Click" />
                    <Button x:Name="BtnSelCopy" Content="复制名称" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnSelCopy_Click" />
                    <Button x:Name="BtnSelToggle" Content="禁用" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnSelToggle_Click" />
                    <Button x:Name="BtnSelPage" Content="打开网页" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnSelPage_Click" />
                    <Button x:Name="BtnSelFolder" Content="打开文件夹" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnSelFolder_Click" />
                    <Button x:Name="BtnSelDelete" Content="删除" Style="{StaticResource BtnDanger}"
                            Margin="8,0,0,0" Click="BtnSelDelete_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
