<UserControl x:Class="SMM.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Window}">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnRescan" Content="重新扫描" Style="{StaticResource Btn}"
                        Click="BtnRescan_Click" />
                <Button x:Name="BtnOpenConfigs" Content="打开 Mods 目录" Style="{StaticResource Btn}"
                        Margin="8,0,0,0" Click="BtnOpenMods_Click" />

                <TextBox x:Name="TxtSearch" Width="230" MinWidth="180" Margin="8,0,0,0"
                         TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"
                         ToolTip="中英文都能搜：Mod 名 / 中文名 / 配置项（SaveKey→保存）/ 按键（左Ctrl→LeftControl）/ 已禁用…&#x0a;多个词用空格分隔，会要求全部命中"
                         Tag="搜索 Mod / 配置项 / 按键（中英都行）" />
                <Button x:Name="BtnClearSearch" Content="清空" Style="{StaticResource Btn}"
                        Margin="6,0,0,0" Click="BtnClearSearch_Click"
                        ToolTip="清空搜索框（Esc 同效）" />

                <ComboBox x:Name="CmbFilter" Width="140" Margin="8,0,0,0" SelectedIndex="0"
                          SelectionChanged="CmbFilter_SelectionChanged"
                          ToolTip="只看重复：只留下和其他功能撞车的那些">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="只看重复" />
                    <ComboBoxItem Content="只看启用中" />
                    <ComboBoxItem Content="只看已禁用" />
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="TxtSummary" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource T.Dim}" />
        </Grid>

        <!-- 冲突提示 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="按键重复检查" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                <TextBlock x:Name="TxtConflicts" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtCoverage" Style="{StaticResource T.Dim}" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 列表 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,6,6,6">
            <ListView x:Name="List" SelectionMode="Extended"
                      ItemContainerStyle="{StaticResource ModListItem}"
                      SelectionChanged="List_SelectionChanged"
                      MouseDoubleClick="List_MouseDoubleClick"
                      ToolTip="双击一行可直接改键；选中后下方也有「改键…」按钮">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Mod" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModName}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderName}" FontSize="11"
                                                   Foreground="{StaticResource B.TextDim}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="功能（配置项）" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding JsonPath}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="按键" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource B.Accent}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="状态" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.TextDim}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="重复" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ConflictText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Danger}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 选中详情 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtSelTitle" Text="在上面选一条按键设置" Style="{StaticResource T.Title}" />
                    <TextBlock x:Name="TxtSelMeta" Style="{StaticResource T.Dim}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtSelDesc" Style="{StaticResource T.Dim}" Margin="0,6,0,0"
                               TextWrapping="Wrap" MaxHeight="72" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEdit" Content="改键…" Style="{StaticResource BtnAccent}"
                            Click="BtnEdit_Click" />
                    <Button x:Name="BtnDisable" Content="禁用" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnDisable_Click"
                            ToolTip="把这个快捷键的值写成 None（SMAPI 视为没绑定），原值会记下来，随时能启用回来" />
                    <Button x:Name="BtnEnable" Content="启用" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnEnable_Click" />
                    <Button x:Name="BtnConfig" Content="打开配置文件" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnConfig_Click" />
                    <Button x:Name="BtnFolder" Content="打开所在文件夹" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" Click="BtnFolder_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
