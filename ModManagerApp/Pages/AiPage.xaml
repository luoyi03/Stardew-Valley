<UserControl x:Class="SMM.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Window}">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnFetch" Content="从接口拉取模型列表" Style="{StaticResource Btn}"
                        Click="BtnFetch_Click" />
                <Button x:Name="BtnSave" Content="保存并应用" Style="{StaticResource BtnAccent}"
                        Margin="8,0,0,0" Click="BtnSave_Click"
                        ToolTip="把上面的接口地址 / 密钥 / 模型写进勾选的那个（或那两个）Mod 的 config.json" />
                <Button x:Name="BtnReload" Content="重新读取" Style="{StaticResource Btn}"
                        Margin="8,0,0,0" Click="BtnReload_Click" />
                <Button x:Name="BtnBackup" Content="打开备份目录" Style="{StaticResource Btn}"
                        Margin="8,0,0,0" Click="BtnBackup_Click"
                        ToolTip="每次改配置前都会自动备份一份到这里" />
            </StackPanel>
            <TextBlock x:Name="TxtStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource T.Dim}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
        </Grid>

        <!-- 要写入的设置 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="接口与模型（这里填的值会被写进下面勾选的 Mod）" Style="{StaticResource T.Section}"
                           Margin="0,0,0,8" />

                <TextBlock Text="模型方案（一键填接口地址 + 模型）" Style="{StaticResource T.Dim}" />
                <ComboBox x:Name="CmbPreset" MinHeight="32" Margin="0,4,0,10" Width="420"
                          HorizontalAlignment="Left" SelectionChanged="CmbPreset_SelectionChanged" />

                <TextBlock Text="接口地址 BaseUrl" Style="{StaticResource T.Dim}" />
                <TextBox x:Name="TxtBaseUrl" MinHeight="32" Margin="0,4,0,10"
                         Tag="例如 http://127.0.0.1:52120/v1 或 https://api.deepseek.com/v1" />

                <TextBlock Text="密钥 ApiKey" Style="{StaticResource T.Dim}" />
                <TextBox x:Name="TxtApiKey" MinHeight="32" Margin="0,4,0,10"
                         Tag="本地网关/Ollama 可以留空" />

                <TextBlock Text="模型 Model" Style="{StaticResource T.Dim}" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtModel" Grid.Column="0" MinHeight="32"
                             Tag="例如 hy3 / deepseek-v4.1-flash / glm-5.3-flash" />
                    <ComboBox x:Name="CmbModel" Grid.Column="1" Width="260" MinHeight="32" Margin="8,0,0,0"
                              SelectionChanged="CmbModel_SelectionChanged"
                              ToolTip="从接口拉到的模型 + 常备款；选一下会填进左边的输入框" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 应用范围 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="应用到哪些 Mod" Style="{StaticResource T.Section}" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkCodex" IsChecked="True" Content="游戏内图鉴（InGameCodex）" />
                <TextBlock x:Name="TxtCodexNow" Style="{StaticResource T.Dim}" Margin="24,2,0,8"
                           TextWrapping="Wrap" />
                <CheckBox x:Name="ChkAi" IsChecked="True" Content="游戏内 AI 助手（StardewAI）" />
                <TextBlock x:Name="TxtAiNow" Style="{StaticResource T.Dim}" Margin="24,2,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 说明 -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="说明" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap"
                           Text="· 只改这两个 Mod 的 config.json 里的接口地址 / 密钥 / 模型（以及模型方案那一项），其它设置（按键、温度、提示词…）一律不动。" />
                <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="· 每次写入前都会自动备份原文件到 数据目录\config-backup\&lt;Mod 目录&gt;\，改错了可以直接抄回去。" />
                <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="· 两个 Mod 都是在加载时读配置，所以改完要重启游戏才生效；游戏内的设置面板里也能改（两边改的是同一份文件）。" />
                <TextBlock Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="· 模型候选里，hy3 / deepseek-v4.1-flash / glm-5.3-flash 永远可选；hy4-preview-f 已从候选里屏蔽（游戏内也一样）。" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtHint" Style="{StaticResource T.Dim}" Margin="0,10,0,0"
                   TextWrapping="Wrap" VerticalAlignment="Top" />
    </Grid>
</UserControl>
