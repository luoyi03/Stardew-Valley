<UserControl x:Class="SMM.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Window}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <TextBlock Text="设置" Style="{StaticResource T.Title}" Margin="0,0,0,14" />

                <!-- 游戏目录 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="游戏目录" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGamePath" Grid.Column="0" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Click="BtnBrowse_Click" />
                            <Button Grid.Column="2" Content="自动检测" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Click="BtnDetect_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtGameState" Style="{StaticResource T.Dim}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 账号 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="账号与接口（都是可选项）" Style="{StaticResource T.Section}" Margin="0,0,0,6" />

                        <TextBlock Text="Nexus Mods API Key" Style="{StaticResource T.Dim}" Margin="0,6,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNexusKey" Grid.Column="0"
                                     Tag="粘贴你的 Nexus API Key（免费申请，不用留空也能检测 Nexus 更新）" />
                            <Button Grid.Column="1" Content="获取 Key" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Click="BtnGetNexusKey_Click" />
                            <Button x:Name="BtnTestNexus" Grid.Column="2" Content="测试连接"
                                    Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BtnTestNexus_Click" />
                            <Button Grid.Column="3" Content="从游戏内导入" Style="{StaticResource Btn}"
                                    Margin="8,0,0,0" ToolTip="读取 Mods\ModManager\config.json 里已经填过的 Key 和更新源"
                                    Click="BtnImportInGame_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtNexusState" Style="{StaticResource T.Dim}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="免费申请：nexusmods.com → 右上角头像 → API Keys（也可以直接点右边按钮）。填了才能读 Nexus 榜单和检测 Nexus Mod 更新。"
                                   Style="{StaticResource T.Dim}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="GitHub Token（可选）" Style="{StaticResource T.Dim}" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtGithubToken" Grid.Column="0"
                                     Tag="可选：粘贴 GitHub Token 提高接口限额" />
                            <Button Grid.Column="1" Content="获取 Token" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Click="BtnGetGithubToken_Click" />
                        </Grid>
                        <TextBlock Text="不填也能用，只是 GitHub 接口每小时限 60 次；填了能到 5000 次。只需要勾选 public_repo 权限（或什么权限都不勾）。"
                                   Style="{StaticResource T.Dim}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 浏览器 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="打开网页用哪个浏览器" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbBrowser" Grid.Column="0" Width="230" SelectedIndex="0"
                                      SelectionChanged="CmbBrowser_SelectionChanged">
                                <ComboBoxItem Content="自动（有 Edge 就用 Edge）" Tag="auto" />
                                <ComboBoxItem Content="Microsoft Edge" Tag="edge" />
                                <ComboBoxItem Content="Google Chrome" Tag="chrome" />
                                <ComboBoxItem Content="系统默认浏览器" Tag="default" />
                                <ComboBoxItem Content="自定义…" Tag="custom" />
                            </ComboBox>
                            <TextBox x:Name="TxtBrowserPath" Grid.Column="1" Margin="8,0,0,0"
                                     IsEnabled="False" Tag="浏览器 exe 的完整路径" />
                            <Button x:Name="BtnBrowserBrowse" Grid.Column="2" Content="浏览…"
                                    Style="{StaticResource Btn}" Margin="8,0,0,0" IsEnabled="False"
                                    Click="BtnBrowserBrowse_Click" />
                        </Grid>
                        <TextBlock x:Name="TxtBrowserState" Style="{StaticResource T.Dim}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <Button x:Name="BtnBrowserTest" Content="试一下（打开 SMAPI 官网）"
                                Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="BtnBrowserTest_Click" />
                    </StackPanel>
                </Border>

                <!-- 下载文件夹监控 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="监控下载文件夹" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkWatch" Content="开启监控：程序运行时盯着下面这个文件夹，发现新的 zip 就处理"
                                  Checked="ChkWatch_Changed" Unchecked="ChkWatch_Changed" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtWatchFolder" Grid.Column="0" Tag="下载文件夹，例如 D:\下载"
                                     TextChanged="TxtWatchFolder_TextChanged" />
                            <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Btn}" Margin="8,0,0,0"
                                    Click="BtnWatchBrowse_Click" />
                            <Button x:Name="BtnWatchScan" Grid.Column="2" Content="立即检查"
                                    Style="{StaticResource Btn}" Margin="8,0,0,0" Click="BtnWatchScan_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="发现新压缩包时：" VerticalAlignment="Center"
                                       Foreground="{StaticResource B.TextDim}" />
                            <ComboBox x:Name="CmbWatchMode" Width="210" Margin="10,0,0,0" SelectedIndex="0"
                                      SelectionChanged="CmbWatchMode_SelectionChanged">
                                <ComboBoxItem Content="弹窗问我（推荐）" Tag="ask" />
                                <ComboBoxItem Content="直接自动安装，不问" Tag="auto" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock x:Name="TxtWatchState" Style="{StaticResource T.Dim}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource T.Dim}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="用法：需要手动下载的 Mod（比如 Nexus 上的），点「打开网页」在浏览器里点下载，zip 落到这个文件夹后程序会自动认出来并安装。以后从任何地方下的 Mod 丢进来也一样。" />
                    </StackPanel>
                </Border>

                <!-- 行为 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="更新与备份行为" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkBackupUpdate" Content="更新 / 覆盖安装前，先把旧版本备份一份" />
                        <CheckBox x:Name="ChkBackupDelete" Content="删除 Mod 前先备份一份（误删可还原）" />
                        <CheckBox x:Name="ChkPrerelease" Content="把测试版（Beta / prerelease）也当成可更新版本" />
                        <CheckBox x:Name="ChkCheckOnStart" Content="打开程序时自动检查一次更新" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="每个 Mod 最多保留几份备份：" VerticalAlignment="Center"
                                       Foreground="{StaticResource B.TextDim}" />
                            <TextBox x:Name="TxtKeep" Width="70" Margin="10,0,0,0" />
                            <TextBlock Text="份（超过的旧备份会自动删掉）" VerticalAlignment="Center"
                                       Foreground="{StaticResource B.TextDim}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 手动补更新源 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="手动补写更新源" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                        <TextBlock Text="有些 Mod 作者没写 UpdateKeys，检测不到更新。这里可以按「ModID = 更新源」一行一个补上。"
                                   Style="{StaticResource T.Dim}" TextWrapping="Wrap" />
                        <TextBlock Text="更新源写法：Nexus:3753 或 https://www.nexusmods.com/stardewvalley/mods/3753 或 https://github.com/作者/仓库"
                                   Style="{StaticResource T.Dim}" Margin="0,4,0,6" TextWrapping="Wrap" />
                        <TextBox x:Name="TxtExtraKeys" AcceptsReturn="True" Height="110"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI"
                                 Tag="一行一个，例如：&#10;FlashShifter.SVECode = Nexus:3753&#10;Richard2091.MapTeleport = GitHub:Richard2091/MapTeleport" />
                    </StackPanel>
                </Border>

                <!-- 忽略列表 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="不检查更新的 Mod" Style="{StaticResource T.Section}" Margin="0,0,0,6" />
                        <TextBlock Text="一行一个 Mod 的 UniqueID（在「Mod 管理」列表里名称下面那行小字）。列在这里的 Mod 不会去查更新。"
                                   Style="{StaticResource T.Dim}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBox x:Name="TxtIgnored" AcceptsReturn="True" Height="90"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI"
                                 Tag="一行一个 UniqueID，例如：&#10;Pathoschild.ContentPatcher" />
                    </StackPanel>
                </Border>

                <!-- 操作 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="BtnSave" Content="保存设置" Style="{StaticResource BtnAccent}" Click="BtnSave_Click" />
                    <Button x:Name="BtnReset" Content="恢复默认" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Click="BtnReset_Click" />
                    <Button x:Name="BtnOpenData" Content="打开数据目录" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Click="BtnOpenData_Click" />
                    <Button x:Name="BtnOpenLog" Content="查看日志" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Click="BtnOpenLog_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
