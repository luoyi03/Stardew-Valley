<Window x:Class="SMM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星露谷 Mod 管理器"
        Height="780" Width="1200" MinHeight="560" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{StaticResource B.Window}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource B.Accent}"
                            Margin="0,0,12,0">
                        <TextBlock Text="M" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="星露谷 Mod 管理器" Style="{StaticResource T.Title}" />
                        <TextBlock x:Name="TxtGamePath" Style="{StaticResource T.Dim}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BadgeRunning" Background="#FF2B4636" CornerRadius="6" Padding="9,5"
                            Margin="0,0,10,0" Visibility="Collapsed"
                            ToolTip="游戏正在运行。装 / 更新 Mod 前请先关掉游戏">
                        <TextBlock Text="● 游戏运行中" Foreground="{StaticResource B.Ok}" FontSize="12" />
                    </Border>
                    <Border Background="{StaticResource B.Panel2}" CornerRadius="6" Padding="9,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtSmapi" Style="{StaticResource T.Dim}" />
                    </Border>
                    <Button x:Name="BtnPlay" Content="打开游戏" Style="{StaticResource BtnAccent}"
                            Margin="0,0,10,0" Click="BtnPlay_Click"
                            ToolTip="用 SMAPI 启动星露谷，这样 Mod 才会加载" />
                    <Button Content="更换游戏目录" Style="{StaticResource Btn}" Click="BtnChangeGame_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource B.Panel}"
                    BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="14,10,14,14">
                        <TextBlock x:Name="TxtVersion" Style="{StaticResource T.Dim}" />
                        <Button Content="打开日志 / 数据目录" Style="{StaticResource BtnLink}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" Click="BtnOpenData_Click" />
                    </StackPanel>

                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}" Margin="0,10,0,0"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Content="Mod 管理" Tag="mods" />
                        <ListBoxItem Content="浏览下载" Tag="browse" />
                        <ListBoxItem Content="AI 设置" Tag="ai" />
                        <ListBoxItem Content="快捷键" Tag="hotkeys" />
                        <ListBoxItem Content="备份回滚" Tag="backup" />
                        <ListBoxItem Content="问题检查" Tag="issues" />
                        <ListBoxItem Content="联机" Tag="mp" />
                        <ListBoxItem Content="设置" Tag="settings" />
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Column="1" />
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Dim}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="BarStatus" Margin="0,7,0,0" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="TxtBusy" Grid.Column="1" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="12" Foreground="{StaticResource B.Info}"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- ================= 提示条 ================= -->
        <Border x:Name="ToastBox" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,58" Background="{StaticResource B.Panel2}" BorderBrush="{StaticResource B.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,10" MaxWidth="900" Visibility="Collapsed">
            <TextBlock x:Name="TxtToast" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
